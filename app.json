{
  "expo": {
    "name": "Pyzara",
    "slug": "test-eas-upload",
    "version": "8.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/EgtakeLogo.png",
    "scheme": "testeasupload",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/egtakeIcon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.emamexp2.testeasupload",
      "permissions": ["CAMERA"],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/EgtakeLogo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/EgtakeLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-video",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pyzara needs photo access so you can upload your skin image for AI skincare suggestions.",
          "cameraPermission": "Pyzara needs camera access so you can take a skin photo for AI skincare suggestions.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "d1205969-c5d0-4608-9c6f-ca3f8da33306"
      }
    },
    "owner": "emamexp2"
  }
}
